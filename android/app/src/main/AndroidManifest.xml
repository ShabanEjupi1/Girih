<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 🚨 Deri te 1.1.0 kjo lojë nuk kërkonte ASNJË leje — ishte e vetmja nga
         të tria. Reklamat e sollën `INTERNET`, dhe kjo ka pasoja që nuk duken
         te kodi: «Siguria e të dhënave» te Play kalon nga «nuk mblidhet asgjë»
         te «Identifikues pajisjeje — mblidhen DHE ndahen, për reklama», dhe
         çdo premtim «pa reklama» te listimi bëhet i rremë.
         Loja vetë mbetet e plotë pa rrjet: nivelet janë në kod, përparimi në
         pajisje. Interneti i duhet VETËM reklamës. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- ⚠️ `com.google.android.gms.permission.AD_ID` NUK shkruhet këtu: e shton
         vetë `google_mobile_ads` gjatë bashkimit të manifesteve, dhe Play-i
         shikon manifestin e BASHKUAR te AAB-ja. Shkrimi me dorë nuk prish gjë,
         por fsheh se nga vjen. Shih memory `play-artefaktet-e-vjetra-bllokojne`. -->

    <application
        android:label="Girih"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Identifikuesi i aplikacionit te AdMob. Pa këtë rresht aplikacioni
             RRËZOHET në nisje me një përjashtim të qartë nga SDK-ja — jo në
             heshtje, ndaj s'ka si të kalojë pa u vënë re.
             ⚠️ Ky është i GIRIH-ut (`~4045126137`). Mat! e ka `~3928973421`
             dhe Tokërrgjiku `~3673667026`: e njëjta llogari AdMob, tri
             aplikacione. Një identifikues i huaj nuk jep gabim — jep zero
             mbushje, që zbulohet vetëm javë më vonë te raportet. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1776059573171352~4045126137"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
